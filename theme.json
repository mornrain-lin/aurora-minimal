{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "背景"
				},
				{
					"slug": "surface",
					"color": "#f7f7f8",
					"name": "浅底"
				},
				{
					"slug": "text",
					"color": "#1c1c1e",
					"name": "正文"
				},
				{
					"slug": "text-soft",
					"color": "#55555c",
					"name": "次要文字"
				},
				{
					"slug": "muted",
					"color": "#8a8a92",
					"name": "弱化文字"
				},
				{
					"slug": "border",
					"color": "#e6e6e9",
					"name": "线条"
				},
				{
					"slug": "accent",
					"color": "#2b6cb0",
					"name": "强调色"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "系统无衬线",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", \"Noto Sans CJK SC\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "小"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "中"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "大"
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"name": "特大"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "1rem",
			"lineHeight": "1.75"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2.6rem",
					"lineHeight": "1.3",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "1.9rem",
					"lineHeight": "1.3",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"lineHeight": "1.4",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.075rem",
					"lineHeight": "1.4",
					"fontWeight": "600"
				}
			},
			"blockquote": {
				"color": {
					"text": "var(--wp--preset--color--text-soft)"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--border)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "24px",
						"right": "24px"
					}
				}
			},
			"code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontSize": "0.875em"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/table": {
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "页头",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "页脚",
			"area": "footer"
		}
	]
}
